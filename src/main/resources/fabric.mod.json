{
	"schemaVersion": 1,
	"id": "hudk",
	"version": "${version}",
	"name": "Hud Keys",
	"description": "Shows key presses on the in-game HUD (displays keybind names and states).",
	"authors": [
		"AlexTGG"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/hud-keys",
		"sources": "https://github.com/AlexTGG/Hud-Keys",
		"issues": "https://github.com/AlexTGG/Hud-Keys/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/hudk/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"hudkeys.hudk.HudKeysClient"
		],
		"modmenu": [
			"hudkeys.hudk.integration.ModMenuIntegration"
		]
	},
	"mixins": [
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"cloth-config": ">=${cloth_config_version}"
	},
	"suggests": {
		"modmenu": "*"
	}

}
